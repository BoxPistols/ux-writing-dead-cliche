{
  "name": "textlint-rule-ux-writing-dead-cliche",
  "version": "0.14.1",
  "description": "AI特有の日本語クリシェを検出し、平易な文章へ直すための辞書とツール。CLI・textlint・Claude Codeプラグインで同じ辞書が動く",
  "type": "module",
  "bin": {
    "dead-cliche": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./engine": "./src/engine.mjs",
    "./load-rules": "./src/load-rules.mjs",
    "./textlint-rule": "./src/textlint-rule.mjs"
  },
  "files": [
    "src",
    "rules",
    "presets",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "sync": "npm run docs:prompts && npm run docs:webdata && npm run docs:comparison && npm test && npm run check:self",
    "gaps": "node tools/gap-report.mjs",
    "check:self": "node src/cli.mjs check README.md CONTRIBUTING.md",
    "docs:comparison": "node tools/render-comparison.mjs > docs/before-after.md",
    "build:claude-ai-skill": "node tools/build-claude-ai-skill.mjs",
    "docs:prompts": "node tools/render-prompts.mjs",
    "docs:webdata": "node tools/render-webdata.mjs",
    "release": "node tools/release.mjs"
  },
  "keywords": [
    "japanese",
    "ux-writing",
    "textlint",
    "proofreading",
    "claude-code-plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoxPistols/ux-writing-dead-cliche.git"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "homepage": "https://boxpistols.github.io/ux-writing-dead-cliche/"
}
